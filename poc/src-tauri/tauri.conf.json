{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Shelf",
  "version": "0.2.0-beta.1",
  "identifier": "io.github.jianan757-gif.promptshelf",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "quick_panel", "title": "Prompt Shelf 0.2.0-beta.1 · 快捷面板", "width": 560, "height": 790, "minWidth": 540, "minHeight": 420, "visible": false, "alwaysOnTop": true, "decorations": false, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Prompt Shelf 提示词与图片资料库（候选版）",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
